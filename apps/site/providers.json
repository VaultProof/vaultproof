{
  "version": 1,
  "updated": "2026-04-11",
  "providers": [
    {
      "id": "anthropic",
      "label": "Anthropic",
      "upstream_base_url": "https://api.anthropic.com",
      "auth_header_name": "x-api-key",
      "auth_header_template": "{key}",
      "extra_headers": { "anthropic-version": "2023-06-01" },
      "env_var_default": "ANTHROPIC_API_KEY",
      "base_url_env_var": "ANTHROPIC_BASE_URL",
      "base_url_path_suffix": "/p/anthropic",
      "detect": {
        "regex": "^sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{80,}$"
      }
    },
    {
      "id": "groq",
      "label": "Groq",
