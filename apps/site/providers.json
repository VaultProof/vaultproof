      "env_var_default": "GROQ_API_KEY",
      "base_url_env_var": "GROQ_BASE_URL",
      "base_url_path_suffix": "/p/groq/openai/v1",
      "detect": {
        "regex": "^gsk_[A-Za-z0-9]{40,}$"
      }
    },
