#!/bin/sh
set -eu

BASE_URL="${VAULTPROOF_INSTALL_BASE_URL:-https://vaultproof.dev/downloads}"
INSTALL_DIR="${VAULTPROOF_INSTALL_DIR:-$HOME/.vaultproof/bin}"
BIN_PATH="$INSTALL_DIR/vaultproof-init"
PROVIDERS_PATH="$INSTALL_DIR/providers.json"

if ! command -v node >/dev/null 2>&1; then
  echo "VaultProof init requires Node.js 18 or newer." >&2
  echo "Install Node.js, then rerun: curl -fsSL https://vaultproof.dev/install | sh" >&2
  exit 1
fi

if ! node -e "const v=Number(process.versions.node.split('.')[0]); process.exit(v >= 18 ? 0 : 1)" >/dev/null 2>&1; then
  echo "VaultProof init requires Node.js 18 or newer." >&2
  echo "Current Node version: $(node -v)" >&2
  exit 1
fi

download() {
  url="$1"
  dest="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" -o "$dest"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$dest" "$url"
  else
    echo "Install curl or wget, then rerun the VaultProof installer." >&2
    exit 1
  fi
}

manifest_sha() {
  file_name="$1"
  node -e '
const fs = require("fs");
const manifest = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
const entry = (manifest.files || []).find((file) => file.path === process.argv[2]);
if (!entry || typeof entry.sha256 !== "string" || !/^[a-f0-9]{64}$/i.test(entry.sha256)) {
  console.error(`Missing SHA-256 for ${process.argv[2]} in VaultProof manifest.`);
  process.exit(1);
}
process.stdout.write(entry.sha256.toLowerCase());
' "$MANIFEST_PATH" "$file_name"
}

verify_sha256() {
  file_path="$1"
  expected_sha="$2"
  label="$3"
  node -e '
const fs = require("fs");
const crypto = require("crypto");
const actual = crypto.createHash("sha256").update(fs.readFileSync(process.argv[1])).digest("hex");
if (actual !== process.argv[2]) {
  console.error(`VaultProof installer integrity check failed for ${process.argv[3]}.`);
  console.error(`Expected ${process.argv[2]}, got ${actual}.`);
  process.exit(1);
}
' "$file_path" "$expected_sha" "$label"
}

mkdir -p "$INSTALL_DIR"
tmp_dir="$(mktemp -d 2>/dev/null || mktemp -d -t vaultproof)"
trap 'rm -rf "$tmp_dir"' EXIT INT TERM
MANIFEST_PATH="$tmp_dir/manifest.json"

download "$BASE_URL/vaultproof-init-manifest.json" "$MANIFEST_PATH"
download "$BASE_URL/vaultproof-init.mjs" "$tmp_dir/vaultproof-init"
download "$BASE_URL/providers.json" "$tmp_dir/providers.json"

verify_sha256 "$tmp_dir/vaultproof-init" "$(manifest_sha "vaultproof-init.mjs")" "vaultproof-init.mjs"
verify_sha256 "$tmp_dir/providers.json" "$(manifest_sha "providers.json")" "providers.json"

chmod 755 "$tmp_dir/vaultproof-init"
mv "$tmp_dir/vaultproof-init" "$BIN_PATH"
mv "$tmp_dir/providers.json" "$PROVIDERS_PATH"

echo "VaultProof init installed:"
echo "  $BIN_PATH"
echo

case ":$PATH:" in
  *":$INSTALL_DIR:"*)
    echo "Run:"
    echo "  vaultproof-init"
    ;;
  *)
    echo "Add VaultProof to your PATH:"
    echo "  export PATH=\"$INSTALL_DIR:\$PATH\""
    echo
    echo "Then run:"
    echo "  vaultproof-init"
    echo
    echo "Or run it directly now:"
    echo "  $BIN_PATH"
    ;;
esac
