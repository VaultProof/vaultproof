# Block new markdown files from accidental commits by default.
# Keep intentional project docs unblocked.
*.md
!README.md
!docs/**/*.md
!packages/**/README.md

docs/enterprise/gcp-runtime-code-copy.md
docs/enterprise/gcp-runtime-vm-copy.md

# Block additional text-like files by default.
*.txt
*.log
*.sql

# Keep intentional tracked files unblocked.
!apps/site/llms.txt
!apps/site/llms-full.txt
!supabase/migrations/*.sql
