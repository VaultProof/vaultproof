{
  "name": "zkvault",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=@zkvault/shamir --filter=@zkvault/backend",
    "start": "node packages/backend/dist/index.js",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "postinstall": "prisma generate --schema=packages/backend/prisma/schema.prisma"
  },
  "packageManager": "npm@10.9.2",
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
