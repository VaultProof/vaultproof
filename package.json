{
  "name": "vaultproof",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=@vaultproof/shamir --filter=@vaultproof/backend --force",
    "start": "node packages/backend/dist/index.js",
    "deploy:worker": "cd packages/worker && npx wrangler deploy",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "postinstall": "prisma generate --schema=packages/backend/prisma/schema.prisma"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@noir-lang/noir_js": "^0.36.0",
    "@prisma/client": "^6.4.0",
    "prisma": "^6.4.0"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
