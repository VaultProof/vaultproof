{
  "name": "vaultproof",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build --force",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "deploy:init-worker": "cd packages/init-worker && npx wrangler deploy",
    "deploy:init-worker:staging": "cd packages/init-worker && npx wrangler deploy --env staging"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
