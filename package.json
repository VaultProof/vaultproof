{
  "name": "vaultproof",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build --force",
    "build:enterprise": "npm run build --workspace @vaultproof/core && npm run build --workspace @vaultproof/enterprise-control-plane && npm run build --workspace @vaultproof/enterprise-secure-executor",
    "docker:build:enterprise-control-plane": "docker build -f packages/enterprise-control-plane/Dockerfile -t vaultproof-enterprise-control-plane .",
    "docker:build:enterprise-secure-executor": "docker build -f packages/enterprise-secure-executor/Dockerfile -t vaultproof-enterprise-secure-executor .",
    "deploy:enterprise-vm": "bash infra/azure/enterprise-secure-runtime/deploy-confidential-vm-app.sh",
    "cleanup:enterprise-container-apps": "bash infra/azure/enterprise-secure-runtime/cleanup-container-apps-prototype.sh",
    "cutover:enterprise-apim": "bash infra/azure/enterprise-secure-runtime/cutover-front-door-apim.sh",
    "cutover:enterprise-origin-tls": "bash infra/azure/enterprise-secure-runtime/cutover-front-door-origin-tls.sh",
    "evidence:enterprise-production": "bash infra/azure/enterprise-secure-runtime/collect-production-evidence.sh",
    "harden:enterprise-ssh": "bash infra/azure/enterprise-secure-runtime/harden-ssh-bootstrap.sh",
    "validate:enterprise-evidence": "node scripts/validate-enterprise-production-evidence.mjs",
    "seed:enterprise-demo-account": "node scripts/create-enterprise-demo-account.mjs",
    "dev": "turbo run dev",
    "test:enterprise-control-plane-smoke": "npm run build:enterprise && node scripts/enterprise-control-plane-smoke.mjs",
    "test:enterprise-smoke": "npm run build:enterprise && node scripts/enterprise-secure-executor-smoke.mjs",
    "qa:enterprise-live-app": "node scripts/enterprise-live-app-qa.mjs",
    "qa:enterprise-live-execute": "node scripts/enterprise-live-execute-test.mjs",
    "prepare:enterprise-origin-cert": "bash infra/azure/enterprise-secure-runtime/prepare-origin-tls-certificate.sh",
    "prepare:enterprise-origin-tls": "bash infra/azure/enterprise-secure-runtime/prepare-origin-tls-cutover.sh",
    "status:enterprise-hardening": "bash infra/azure/enterprise-secure-runtime/enterprise-hardening-status.sh",
    "verify:enterprise-origin-tls": "bash infra/azure/enterprise-secure-runtime/verify-origin-tls-readiness.sh",
    "verify:enterprise-production": "bash infra/azure/enterprise-secure-runtime/verify-production-runtime.sh",
    "verify:enterprise-secrets": "bash infra/azure/enterprise-secure-runtime/verify-runtime-secrets.sh",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "start:enterprise-control-plane": "npm run start --workspace @vaultproof/enterprise-control-plane",
    "start:enterprise-secure-executor": "npm run start --workspace @vaultproof/enterprise-secure-executor",
    "deploy:init-worker": "cd packages/init-worker && npx wrangler deploy",
    "deploy:init-worker:staging": "cd packages/init-worker && npx wrangler deploy --env staging"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
