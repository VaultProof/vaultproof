{
  "name": "vaultproof",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build --force",
    "build:enterprise": "npm run build --workspace @vaultproof/core && npm run build --workspace @vaultproof/enterprise-control-plane && npm run build --workspace @vaultproof/enterprise-secure-executor",
    "docker:build:enterprise-control-plane": "docker build -f packages/enterprise-control-plane/Dockerfile -t vaultproof-enterprise-control-plane .",
    "docker:build:enterprise-secure-executor": "docker build -f packages/enterprise-secure-executor/Dockerfile -t vaultproof-enterprise-secure-executor .",
    "deploy:enterprise-vm": "bash infra/azure/enterprise-secure-runtime/deploy-confidential-vm-app.sh",
    "build:gcp-enterprise-images": "bash infra/gcp/enterprise-secure-runtime/build-images.sh",
    "provision:gcp-enterprise-core": "bash infra/gcp/enterprise-secure-runtime/provision-core.sh",
    "deploy:gcp-enterprise-vm": "bash infra/gcp/enterprise-secure-runtime/deploy-confidential-vm.sh",
    "render:gcp-enterprise-control-plane-env": "bash infra/gcp/enterprise-secure-runtime/render-control-plane-env.sh",
    "render:gcp-enterprise-executor-env": "bash infra/gcp/enterprise-secure-runtime/render-executor-env.sh",
    "encrypt:gcp-enterprise-unwrap-key": "bash infra/gcp/enterprise-secure-runtime/encrypt-vault-unwrap-key.sh",
    "configure:gcp-enterprise-edge": "bash infra/gcp/enterprise-secure-runtime/configure-public-edge.sh",
    "configure:gcp-enterprise-cloud-armor": "bash infra/gcp/enterprise-secure-runtime/configure-cloud-armor.sh",
    "configure:gcp-enterprise-origin-lock": "bash infra/gcp/enterprise-secure-runtime/configure-origin-lock.sh",
    "verify:gcp-enterprise-edge": "bash infra/gcp/enterprise-secure-runtime/verify-public-edge.sh",
    "verify:gcp-enterprise-cloud-armor": "bash infra/gcp/enterprise-secure-runtime/verify-cloud-armor.sh",
    "publish:gcp-enterprise-secrets": "bash infra/gcp/enterprise-secure-runtime/publish-runtime-secrets.sh",
    "collect:gcp-runtime-evidence": "bash infra/gcp/enterprise-secure-runtime/collect-runtime-evidence.sh",
    "prepare:gcp-first-goal-runtime": "bash infra/gcp/enterprise-secure-runtime/prepare-first-goal-runtime.sh",
    "gate:gcp-first-goal": "node scripts/run-gcp-first-goal-gate.mjs",
    "gate:gcp-customer-launch": "node scripts/run-gcp-customer-launch-gate.mjs",
    "docs:gcp-build-status": "node scripts/update-gcp-build-doc.mjs",
    "cleanup:enterprise-container-apps": "bash infra/azure/enterprise-secure-runtime/cleanup-container-apps-prototype.sh",
    "configure:enterprise-internal-admin-front-door": "bash infra/azure/enterprise-secure-runtime/configure-internal-admin-front-door.sh",
    "cutover:enterprise-apim": "bash infra/azure/enterprise-secure-runtime/cutover-front-door-apim.sh",
    "cutover:enterprise-origin-tls": "bash infra/azure/enterprise-secure-runtime/cutover-front-door-origin-tls.sh",
    "evidence:enterprise-production": "bash infra/azure/enterprise-secure-runtime/collect-production-evidence.sh",
    "gate:enterprise-finish": "node scripts/run-enterprise-finish-gate.mjs",
    "gate:enterprise-handoff": "node scripts/run-enterprise-handoff-gate.mjs",
    "harden:enterprise-ssh": "bash infra/azure/enterprise-secure-runtime/harden-ssh-bootstrap.sh",
    "package:enterprise-handoff": "node scripts/build-enterprise-handoff-package.mjs",
    "validate:enterprise-evidence": "node scripts/validate-enterprise-production-evidence.mjs",
    "seed:enterprise-demo-account": "node scripts/create-enterprise-demo-account.mjs",
    "seal:enterprise-provider-slot": "node scripts/enterprise-seal-provider-slot.mjs",
    "mint:enterprise-runtime-token": "node scripts/enterprise-mint-runtime-token.mjs",
    "dev": "turbo run dev",
    "test:enterprise-control-plane-smoke": "npm run build:enterprise && node scripts/enterprise-control-plane-smoke.mjs",
    "test:enterprise-apim-policies": "node scripts/enterprise-apim-policy-docs-smoke.mjs",
    "test:enterprise-smoke": "npm run build:enterprise && node scripts/enterprise-secure-executor-smoke.mjs",
    "qa:enterprise-live-app": "node scripts/enterprise-live-app-qa.mjs",
    "qa:enterprise-login": "node scripts/enterprise-login-readiness.mjs",
    "qa:enterprise-live-execute": "node scripts/enterprise-live-execute-test.mjs",
    "prepare:enterprise-alternate-access": "bash infra/azure/enterprise-secure-runtime/prepare-alternate-access.sh",
    "prepare:enterprise-apim-jwt": "bash infra/azure/enterprise-secure-runtime/prepare-apim-jwt-validation.sh",
    "prepare:enterprise-internal-admin": "bash infra/azure/enterprise-secure-runtime/prepare-internal-admin.sh",
    "prepare:enterprise-mtls": "bash infra/azure/enterprise-secure-runtime/prepare-mtls-caller-lock.sh",
    "prepare:enterprise-private-origin": "bash infra/azure/enterprise-secure-runtime/prepare-private-origin.sh",
    "prepare:enterprise-secret-rotation": "bash infra/azure/enterprise-secure-runtime/prepare-secret-rotation.sh",
    "prepare:enterprise-origin-cert": "bash infra/azure/enterprise-secure-runtime/prepare-origin-tls-certificate.sh",
    "prepare:enterprise-origin-tls": "bash infra/azure/enterprise-secure-runtime/prepare-origin-tls-cutover.sh",
    "provision:enterprise-key-vault-release-key": "bash infra/azure/enterprise-secure-runtime/provision-key-vault-release-key.sh",
    "status:enterprise-hardening": "bash infra/azure/enterprise-secure-runtime/enterprise-hardening-status.sh",
    "verify:enterprise-origin-tls": "bash infra/azure/enterprise-secure-runtime/verify-origin-tls-readiness.sh",
    "verify:enterprise-alternate-access": "bash infra/azure/enterprise-secure-runtime/verify-alternate-access-readiness.sh",
    "verify:enterprise-production": "bash infra/azure/enterprise-secure-runtime/verify-production-runtime.sh",
    "verify:enterprise-secrets": "bash infra/azure/enterprise-secure-runtime/verify-runtime-secrets.sh",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "start:enterprise-control-plane": "npm run start --workspace @vaultproof/enterprise-control-plane",
    "start:enterprise-secure-executor": "npm run start --workspace @vaultproof/enterprise-secure-executor",
    "deploy:init-worker": "cd packages/init-worker && npx wrangler deploy",
    "deploy:init-worker:staging": "cd packages/init-worker && npx wrangler deploy --env staging"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
