PORT=3002
VAULTPROOF_EXECUTOR_MODE=demo
ENTERPRISE_EXECUTOR_ACCEPTED_SIGNING_KEYS=enterprise-local:replace-with-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Demo mode only. Production confidential mode must use Azure Secure Key Release.
VAULT_ENCRYPTION_KEY=replace-with-the-existing-worker-encryption-key

# Confidential mode placeholders. These become required when
# VAULTPROOF_EXECUTOR_MODE=confidential.
AZURE_KEY_RELEASE_URL=https://your-key-vault.vault.azure.net/keys/vaultproof-enterprise-unwrap/release
AZURE_ATTESTATION_TOKEN=replace-with-confidential-vm-attestation-token
AZURE_KEY_RELEASE_CACHE_TTL_MS=60000
# Optional local/testing override. Production should use the Confidential VM managed identity.
AZURE_KEY_VAULT_ACCESS_TOKEN=
# Optional Key Vault release encryption algorithm. Leave blank until the attested runtime
# has the matching private unwrap key configured.
AZURE_KEY_RELEASE_ENC=
AZURE_ATTESTATION_PROVIDER_URI=https://your-attestation-provider.attest.azure.net
AZURE_KEY_RELEASE_POLICY_HASH=replace-with-release-policy-sha256
AZURE_KEY_ID=https://your-key-vault.vault.azure.net/keys/vaultproof-enterprise-unwrap
AZURE_KEY_VERSION=replace-with-key-version
AZURE_CONFIDENTIAL_VM_RESOURCE_ID=/subscriptions/.../resourceGroups/.../providers/Microsoft.Compute/virtualMachines/...
AZURE_MEASUREMENT_SUMMARY=replace-with-approved-maa-vtpm-measurement-summary
VAULTPROOF_EXECUTOR_BUILD_DIGEST=replace-with-image-or-build-digest
