generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  passwordHash         String?        @map("password_hash")
  tier                 String         @default("free") // free, starter, pro, team, enterprise
  stripeCustomerId     String?        @unique @map("stripe_customer_id")
  stripeSubscriptionId String?        @map("stripe_subscription_id")
  globalDailyLimit     Int?           @map("global_daily_limit")    // max total calls/day across ALL keys
  globalMonthlyLimit   Int?           @map("global_monthly_limit")  // max total calls/month across ALL keys
  killSwitch           Boolean        @default(false) @map("kill_switch") // true = ALL proxy calls blocked
  hasSeenTour          Boolean        @default(false) @map("has_seen_tour")
  promoCode            String?        @map("promo_code")
  tierExpiresAt        DateTime?      @map("tier_expires_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  keySlots             KeySlot[]
  developerKeys        DeveloperKey[]
  promoFeedback        PromoFeedback[]
  githubConnections    GithubConnection[]
  scanResults          ScanResult[]
  scanAuditLogs        ScanAuditLog[]

  @@map("users")
}

model DeveloperKey {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  user               User      @relation(fields: [userId], references: [id])
  key                String    @unique // "vp_live_..." or "vp_test_..."
  keyHash            String    @unique @map("key_hash") // SHA-256 hash for lookup
  label              String    @default("Default")
  mode               String    @default("live") // "live" or "test"
  allowedIps         String?   @map("allowed_ips") // comma-separated IPs, null = allow all
  allowedProviders   String?   @map("allowed_providers") // comma-separated: "openai,anthropic", null = allow all
  allowedEndpoints   String?   @map("allowed_endpoints") // comma-separated: "/v1/chat/completions,/v1/models", null = allow all
  allowedKeySlotIds  String?   @map("allowed_key_slot_ids") // comma-separated key slot IDs; null = access all user's keys
  alertEmail         String?   @map("alert_email") // email for usage alerts, null = no alerts
  alertThreshold     Int?      @map("alert_threshold") // calls per hour to trigger alert, null = no alert
  webhookUrl         String?   @map("webhook_url")     // URL to notify on events
  webhookSecret      String?   @map("webhook_secret")  // HMAC secret for signing webhook payloads
  lastUsed           DateTime? @map("last_used")
  createdAt          DateTime  @default(now()) @map("created_at")
  revokedAt          DateTime? @map("revoked_at")
  sessionTokens      SessionToken[]

  @@map("developer_keys")
}

model SessionToken {
  id              String       @id @default(uuid())
  developerKeyId  String       @map("developer_key_id")
  developerKey    DeveloperKey @relation(fields: [developerKeyId], references: [id])
  tokenHash       String       @unique @map("token_hash")
  expiresAt       DateTime     @map("expires_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([developerKeyId, expiresAt])
  @@map("session_tokens")
}

model KeySlot {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  user             User        @relation(fields: [userId], references: [id])
  provider         String      // "openai", "anthropic", "google", etc.
  label            String      // user-friendly name
  envVar           String?     @map("env_var")     // exact env var name, e.g. "NEXT_PUBLIC_SUPABASE_URL"
  share1Encrypted  Bytes       @map("share1_encrypted")  // Encrypted with VAULT_ENCRYPTION_KEY
  share2Encrypted  Bytes?      @map("share2_encrypted")  // Encrypted with key derived from vp_live_ key
  vaultCommitment  String      @map("vault_commitment")
  authAppsRoot     String      @map("auth_apps_root")
  status           String      @default("ACTIVE")
  dailyLimit       Int?        @map("daily_limit")       // max calls per day, null = unlimited
  monthlyLimit     Int?        @map("monthly_limit")     // max calls per month, null = unlimited
  blockOnLimit     Boolean     @default(true) @map("block_on_limit") // true = block, false = alert only
  createdAt        DateTime    @default(now()) @map("created_at")
  rotatedAt        DateTime?   @map("rotated_at")
  expiresAt        DateTime?   @map("expires_at")
  accessLogs       AccessLog[]
  appGrants        AppGrant[]

  @@index([userId, status])     // speeds up key listing per user
  @@index([userId, provider])   // speeds up transparent proxy key lookup
  @@map("key_slots")
}

model AppGrant {
  id         String    @id @default(uuid())
  keySlotId  String    @map("key_slot_id")
  keySlot    KeySlot   @relation(fields: [keySlotId], references: [id])
  appId      String    @map("app_id")
  appName    String    @map("app_name")
  permissions String   @default("{}")
  grantedAt  DateTime  @default(now()) @map("granted_at")
  revokedAt  DateTime? @map("revoked_at")

  @@map("app_grants")
}

model AccessLog {
  id        String   @id @default(uuid())
  keySlotId String   @map("key_slot_id")
  keySlot   KeySlot  @relation(fields: [keySlotId], references: [id])
  appId     String   @map("app_id")
  action    String   // "api_call", "key_rotation", "grant", "revoke"
  zkProof   String   @map("zk_proof")
  nullifier String   @unique
  timestamp DateTime @default(now())
  metadata  String?

  @@index([keySlotId, action, timestamp])  // speeds up rate limit counts + usage queries
  @@index([keySlotId, timestamp])           // speeds up log listing + export
  @@index([appId, timestamp])              // speeds up per-app usage queries
  @@map("access_logs")
}

model PromoFeedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  feedback  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("promo_feedback")
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String   // "pageview", "signup", "key_stored", "first_api_call"
  page      String?  // URL path for pageviews
  referrer  String?  // referrer domain
  sessionId String?  @map("session_id") // random ID from localStorage
  userId    String?  @map("user_id")    // set for product events
  metadata  String?  // JSON string for extra data
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

// ─── Test Results ─────────────────────────────────────────────────────────────

model TestRun {
  id          String    @id @default(uuid())
  status      String    // "passed", "failed", "running"
  total       Int       @default(0)
  passed      Int       @default(0)
  failed      Int       @default(0)
  durationMs  Int?      @map("duration_ms")
  failures    String?   // JSON array of { name, error } for failed tests
  triggeredBy String    @default("manual") @map("triggered_by") // "manual", "cron", "deploy"
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([startedAt])
  @@map("test_runs")
}

model TestSettings {
  id        String  @id @default("singleton")
  enabled   Boolean @default(true)
  cronHour  Int     @default(6) @map("cron_hour") // 0-23, hour in UTC to run daily

  @@map("test_settings")
}

// KeyStatus values: "ACTIVE", "ROTATED", "REVOKED" (stored as String for SQLite compat)

// ─── Scanner ──────────────────────────────────────────────────────────────────

model GithubConnection {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id])
  githubUsername  String    @map("github_username")
  accessToken     String    @map("access_token") // AES-256-GCM encrypted
  scopes          String    // Comma-separated OAuth scopes
  connectedAt     DateTime  @default(now()) @map("connected_at")
  disconnectedAt  DateTime? @map("disconnected_at")

  @@index([userId, disconnectedAt])
  @@map("github_connections")
}

model ScanResult {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  user          User          @relation(fields: [userId], references: [id])
  repoFullName  String        @map("repo_full_name")
  branch        String
  keysFound     Int           @default(0) @map("keys_found")
  keysActive    Int           @default(0) @map("keys_active")
  keysRevoked   Int           @default(0) @map("keys_revoked")
  status        String        @default("in_progress") // in_progress, completed, failed
  startedAt     DateTime      @default(now()) @map("started_at")
  completedAt   DateTime?     @map("completed_at")
  errorMessage  String?       @map("error_message")
  findings      ScanFinding[]
  auditLogs     ScanAuditLog[]

  @@index([userId, startedAt])
  @@map("scan_results")
}

model ScanFinding {
  id          String     @id @default(uuid())
  scanId      String     @map("scan_id")
  scan        ScanResult @relation(fields: [scanId], references: [id], onDelete: Cascade)
  envName     String     @map("env_name")
  provider    String
  file        String
  line        Int?
  mode        String     // proxy, env-injection
  verified    String     // active, revoked, unknown
  source      String     // current, git-history
  action      String     @default("pending") // pending, stored, pr-created, ignored
  prUrl       String?    @map("pr_url")
  maskedValue String     @map("masked_value")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([scanId])
  @@map("scan_findings")
}

model ScanAuditLog {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id])
  scanId    String?     @map("scan_id")
  scan      ScanResult? @relation(fields: [scanId], references: [id], onDelete: SetNull)
  action    String      // connected_github, started_scan, completed_scan, etc.
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([scanId])
  @@map("scan_audit_logs")
}
