{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "westus2"
    },
    "environmentName": {
      "value": "vpent"
    },
    "adminUsername": {
      "value": "azureuser"
    },
    "adminSshPublicKey": {
      "value": "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY nelson@vaultproof"
    },
    "vmSize": {
      "value": "Standard_DC2as_v5"
    },
    "sshSourceCidr": {
      "value": "REPLACE_WITH_YOUR_IP/32"
    },
    "executorSourceCidr": {
      "value": "10.42.1.0/24"
    },
    "allowFrontDoorToControlPlane": {
      "value": false
    },
    "controlPlaneIngressSource": {
      "value": "AzureFrontDoor.Backend"
    },
    "allowApiManagementToControlPlane": {
      "value": false
    },
    "apiManagementIngressSource": {
      "value": "ApiManagement"
    },
    "secureKeyReleasePolicyData": {
      "value": ""
    },
    "deployPrototypeReleaseKey": {
      "value": false
    },
    "deployManagedHsm": {
      "value": false
    },
    "managedHsmInitialAdminObjectId": {
      "value": ""
    },
    "deployApiManagement": {
      "value": false
    },
    "apiManagementPublisherEmail": {
      "value": "security@vaultproof.dev"
    },
    "apiManagementPublisherName": {
      "value": "VaultProof"
    },
    "apiManagementSkuName": {
      "value": "StandardV2"
    },
    "apiManagementCapacity": {
      "value": 1
    },
    "apiManagementBackendUrl": {
      "value": ""
    },
    "apiManagementApiPath": {
      "value": "enterprise"
    },
    "apiManagementSubscriptionRequired": {
      "value": false
    },
    "apiManagementRateLimitCalls": {
      "value": 120
    },
    "apiManagementQuotaCalls": {
      "value": 10000
    },
    "apiManagementMaxRequestBodyBytes": {
      "value": 1048576
    },
    "apiManagementGatewayMarker": {
      "value": "vaultproof-managed"
    },
    "apiManagementOriginLockHeaderName": {
      "value": "x-vaultproof-origin-lock"
    },
    "apiManagementOriginLockSecret": {
      "value": ""
    }
  }
}
